# ---- AI model provider (Ollama Cloud, OpenAI-compatible API) ------------
# Ollama is the configured provider. Models are attempted in order and the
# first successful response is used for the rest of the run.
# When no key is set, RepoMate falls back to the deterministic heuristic
# planner and labels every run honestly.
#
# This file is read by RepoMate itself (API, worker, scripts) at startup —
# no `source .env` needed. A variable already exported in the shell wins.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODELS=gemma4:31b,gpt-oss:120b
# Wall-time budget for one provider call, in seconds.
OLLAMA_TIMEOUT_SECONDS=240
# Retry budget for retryable provider failures (429/5xx), capped at 6.
OLLAMA_MAX_RETRIES=2

# ---- GitHub access ------------------------------------------------------
# Optional PAT to raise the REST API rate limit (60 req/h unauthenticated).
# Never exposed to the frontend or written to logs.
GITHUB_TOKEN=

# ---- Browser/CORS --------------------------------------------------------
# Comma-separated CORS origins allowed to call the API (the web frontend).
# Local dev: http://localhost:3000 — production: your Vercel URL.
ALLOWED_ORIGINS=http://localhost:3000

# ---- RepoMate runtime ---------------------------------------------------
# Where run records, artifacts and (temporary) cloned workspaces live.
REPOMATE_RUNS_ROOT=var/runs
# Keep the cloned workspace after a run finishes (debugging aid).
REPOMATE_KEEP_WORKSPACE=0
# Hard wall-clock budget for one pipeline run, in seconds.
REPOMATE_MAX_RUN_SECONDS=900
# Execute repository test suites inside the process sandbox (wall-time /
# CPU / memory limits, scrubbed environment, denied network egress). Set to
# 0 to report the suite as NOT_RUN instead.
REPOMATE_SANDBOX_ENABLED=1
# Sandbox network policy. Default (unset) is "disabled": egress is denied at
# the OS layer and the boundary is verified by a live probe before untrusted
# code runs. If no enforcing backend exists (bwrap on Linux with unprivileged
# user namespaces), the sandbox REFUSES to execute rather than running with
# network access. Setting "host" permits egress — it is recorded in the
# receipt as policy_enforced: false and is NOT suitable for public
# multi-tenant use. Any other value is treated as "disabled".
REPOMATE_SANDBOX_NETWORK=disabled
# Set to 1 to ignore this file entirely (the hermetic test suite sets this).
REPOMATE_SKIP_DOTENV=0
# At startup, mark runs left RUNNING/PENDING by a previous process as
# FAILED with an explicit reason. Set to 0 to leave them untouched.
REPOMATE_RECONCILE_STALE_RUNS=1
# Planner prompt budget: per-evidence snippet characters (200-4000) and the
# number of evidence records (1-12). Lower these if a gateway times out.
REPOMATE_PLANNER_SNIPPET_CHARS=600
REPOMATE_PLANNER_MAX_EVIDENCE=6
# Evidence-retrieval budgets. Reaching any of these stops the scan and marks
# the run PARTIAL with a report of what was not examined — it never claims a
# complete repository analysis. Raise them for large repositories.
REPOMATE_RETRIEVAL_MAX_FILES=2000
REPOMATE_RETRIEVAL_MAX_BYTES_PER_FILE=200000
REPOMATE_RETRIEVAL_MAX_TOTAL_BYTES=32000000
REPOMATE_RETRIEVAL_MAX_SEARCH_RESULTS=200
REPOMATE_RETRIEVAL_MAX_SECONDS=30
# Per-run model budget. Enforced before every gateway call; gateways that omit
# usage are charged a conservative estimate and the report says so.
REPOMATE_MODEL_MAX_CALLS=10
REPOMATE_MODEL_MAX_TOKENS=120000
# Bounded model-directed retrieval (search_text/read_file/inspect_manifest).
# Hitting one of these global caps ends the run as PARTIAL with the work that
# was left unexamined. Per-search result truncation is reported per call.
REPOMATE_TOOL_MAX_CALLS=8
REPOMATE_TOOL_MAX_TOTAL_BYTES=4000000
REPOMATE_TOOL_MAX_SECONDS=180
REPOMATE_TOOL_MAX_RESULTS=20

# ---- Fair-use admission (API) --------------------------------------------
# Per-client sliding window for POST /api/runs.
REPOMATE_RATE_LIMIT_REQUESTS=20
REPOMATE_RATE_LIMIT_WINDOW_SECONDS=60
# Maximum PENDING+RUNNING runs. Also becomes the worker concurrency default.
REPOMATE_MAX_CONCURRENT_RUNS=3
# Comma-separated IPs/CIDRs whose X-Forwarded-For header is trusted. Leave
# empty unless the API is behind a proxy you control; otherwise a caller can
# spoof the header (the socket peer is used instead).
REPOMATE_TRUSTED_PROXIES=

# ---- Durable execution (Phase 5) -----------------------------------------
# inproc (default) executes runs in the API process; celery hands them to
# the worker via Redis. SQLite is the default store; point
# REPOMATE_DATABASE_URL at PostgreSQL (psycopg required) for production.
REPOMATE_EXECUTION=inproc
REDIS_URL=redis://localhost:6379/0
REPOMATE_DATABASE_URL=
# Workspaces of terminal runs older than this are swept on API startup.
REPOMATE_SWEEP_HOURS=24
