# RepoMate Celery worker image
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends git build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY packages ./packages
COPY services ./services

RUN pip install --no-cache-dir ".[worker,api]"

# pytest is required by the verification sandbox; git by the clone stage.
RUN useradd --create-home repomate && mkdir -p /var/lib/repomate && chown repomate /var/lib/repomate
USER repomate
ENV REPOMATE_RUNS_ROOT=/var/lib/repomate/runs
VOLUME ["/var/lib/repomate"]

CMD ["python", "-m", "services.worker"]
